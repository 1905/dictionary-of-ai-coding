{
  "name": "ai-coding-dictionary",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "tsx internal/generate-readme.ts",
    "prepare": "husky",
    "build": "tsx internal/build-site.ts",
    "preview": "tsx internal/serve.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "prettier --check site tests internal/content.ts internal/build-site.ts internal/review-translation.ts internal/serve.ts internal/check-russian-style.ts translations docs tsconfig.json package.json",
    "test": "tsx --test tests/*.test.ts",
    "translations:review": "tsx internal/review-translation.ts",
    "check": "npm run typecheck && npm run lint && npm run lint:ru && npm test && npm run build",
    "lint:ru": "tsx internal/check-russian-style.ts"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@types/node": "^22.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "marked": "^18.1.1",
    "prettier": "^3.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22"
  }
}
